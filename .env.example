# Réglages de la pile Docker AndTabbax.
# Copiez ce fichier en `.env` pour adapter les valeurs — tout est facultatif,
# docker-compose.yml porte les mêmes valeurs par défaut.
#
#     cp .env.example .env && docker compose up -d --build

# Port d'écoute de l'application sur la machine hôte.
APP_PORT=8080
APP_URL=http://localhost:8080

# `local` + APP_DEBUG=true affichent la trace complète des erreurs.
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=warning

# Laissés vides : le conteneur engendre ces secrets au premier démarrage et les
# conserve dans le volume `backend-storage`. À renseigner pour un vrai
# déploiement (`php artisan key:generate --show`).
APP_KEY=
JWT_SECRET=

# Base de données (conteneur `db`, jamais exposée sur l'hôte).
DB_DATABASE=andtabbax
DB_USERNAME=andtabbax
DB_PASSWORD=andtabbax
DB_ROOT_PASSWORD=andtabbax-root

# Comptes et projets de démonstration au premier démarrage.
# Mettre à `false` pour partir d'une base vide.
DB_SEED=true
